rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Missing-topic reports: signed-in visitors can create only, never read/change/delete.
    match /misses/{missId} {
      allow get, list: if false;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['question','answer','course','uid','createdAt'])
        && request.resource.data.question is string
        && request.resource.data.question.size() <= 2000
        && (!request.resource.data.keys().hasAny(['answer']) || request.resource.data.answer is string)
        && (!request.resource.data.keys().hasAny(['course']) || request.resource.data.course is string)
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }
    // Adult confirmation: each signed-in user reads and writes only their own declaration.
    match /users/{userId} {
      allow get: if request.auth != null && request.auth.uid == userId;
      allow list: if false;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['adultConfirmed','confirmedAt'])
        && request.resource.data.adultConfirmed == true;
      allow delete: if false;
    }

    // Account-bound outcomes only. No activity or reset-history collections.
    function owned(uid) { return request.auth != null && request.auth.uid==uid
      && !exists(/databases/$(database)/documents/users/$(uid)/studyAccess/closed); }
    function questions(id) { return id=="84102~P7"?{"1":"mcq","2":"mcq","3":"mcq","4":"written","5":"written","6":"written","7":"written"}:id=="84102~P9"?{"1":"mcq","2":"ranking","3":"numeric","4":"mcq","5":"ranking"}:id=="84102~P10"?{"1":"mcq","2":"mcq","3":"numeric","4":"mcq","5":"mcq"}:id=="84102~P3"?{"1":"mcq","2":"mcq","3":"numeric","4":"mcq","5":"numeric","6":"written"}:id=="84102~P2"?{"1":"mcq","2":"mcq","3":"numeric","4":"numeric","5":"mcq"}:id=="84102~P5"?{"1":"mcq","2":"mcq","3":"mcq","4":"written","5":"written","6":"mcq"}:id=="84102~P6"?{"1":"mcq","2":"mcq","3":"mcq","4":"ranking","5":"mcq","6":"mcq"}:id=="84102~P8"?{"1":"numeric","2":"mcq","3":"mcq","4":"mcq","5":"mcq","6":"numeric"}:id=="84102~P1"?{"1":"numeric","2":"numeric","3":"numeric","4":"numeric","5":"written","6":"numeric"}:id=="84102~P4"?{"1":"mcq","2":"mcq","3":"numeric","4":"numeric","5":"mcq"}:id=="84102~P11"?{"1":"numeric","2":"numeric","3":"mcq","4":"mcq","5":"numeric","6":"written"}:id=="84102~P12"?{"1":"numeric","2":"numeric","3":"numeric","4":"numeric","5":"numeric","6":"numeric","7":"numeric","8":"numeric","9":"mcq","10":"mcq","11":"mcq","12":"mcq","13":"mcq","14":"numeric","15":"mcq","16":"mcq","17":"numeric","18":"mcq","19":"written","20":"written"}:id=="84101~G1"?{"1":"mcq","2":"numeric","3":"numeric","4":"numeric","5":"mcq","6":"numeric","7":"numeric","8":"numeric","9":"numeric","10":"mcq"}:id=="84101~G2"?{"1":"mcq","2":"numeric","3":"numeric","4":"numeric","5":"numeric"}:id=="84101~G3"?{"1":"numeric","2":"numeric","3":"mcq","4":"ranking","5":"written"}:id=="84101~G4"?{"1":"mcq","2":"numeric","3":"numeric","4":"numeric","5":"written"}:id=="84101~G5"?{"1":"mcq","2":"numeric","3":"numeric","4":"numeric","5":"numeric"}:id=="84101~G6"?{"1":"numeric","2":"numeric","3":"numeric","4":"mcq","5":"numeric"}:id=="84101~G7"?{"1":"mcq","2":"numeric","3":"numeric","4":"mcq","5":"numeric"}:id=="84101~G8"?{"1":"numeric","2":"mcq","3":"numeric","4":"numeric","5":"written"}:id=="84101~G9"?{"1":"numeric","2":"numeric","3":"numeric","4":"numeric","5":"numeric","6":"numeric","7":"numeric","8":"mcq","9":"mcq","10":"numeric"}:id=="84101~G10"?{"1":"numeric","2":"numeric","3":"numeric","4":"mcq","5":"mcq","6":"numeric","7":"numeric","8":"mcq","9":"mcq","10":"numeric","11":"mcq","12":"numeric","13":"mcq","14":"numeric","15":"mcq","16":"mcq","17":"numeric","18":"numeric","19":"numeric","20":"numeric","21":"mcq","22":"mcq","23":"mcq","24":"mcq"}:id=="84101~G11"?{"1":"mcq","2":"mcq","3":"ranking","4":"mcq","5":"written","6":"numeric","7":"mcq","8":"mcq","9":"mcq"}:id=="84101~G12"?{"1":"numeric","2":"numeric","3":"mcq","4":"numeric","5":"mcq","6":"numeric","7":"mcq","8":"numeric"}:id=="84101~G13"?{"1":"numeric","2":"numeric","3":"numeric","4":"mcq","5":"mcq","6":"mcq","7":"numeric","8":"mcq","9":"numeric"}:id=="84101~G14"?{"1":"numeric","2":"numeric","3":"numeric","4":"mcq","5":"mcq","6":"mcq","7":"numeric"}:id=="84101~G15"?{"1":"numeric","2":"numeric","3":"numeric","4":"numeric","5":"mcq","6":"mcq","7":"numeric","8":"numeric","9":"numeric","10":"mcq","11":"numeric"}:id=="84101~G16"?{"1":"numeric","2":"numeric","3":"numeric","4":"numeric","5":"mcq","6":"mcq","7":"mcq","8":"mcq"}:id=="nano~N1"?{"1":"mcq","2":"numeric","3":"mcq","4":"mcq","5":"mcq","6":"mcq","7":"written","8":"written"}:id=="nano~N2"?{"1":"mcq","2":"numeric","3":"mcq","4":"mcq","5":"mcq","6":"mcq","7":"written","8":"written"}:id=="nano~N3"?{"1":"ranking","2":"mcq","3":"mcq","4":"numeric","5":"mcq","6":"mcq","7":"written","8":"written"}:id=="nano~N4"?{"1":"mcq","2":"mcq","3":"mcq","4":"mcq","5":"written","6":"written"}:id=="nano~N5"?{"1":"mcq","2":"mcq","3":"mcq","4":"mcq","5":"written","6":"written"}:id=="nano~N6"?{"1":"mcq","2":"numeric","3":"mcq","4":"mcq","5":"mcq","6":"written","7":"written"}:id=="nano~N7"?{"1":"mcq","2":"mcq","3":"numeric","4":"mcq","5":"mcq","6":"written","7":"written"}:id=="nano~N8"?{"1":"mcq","2":"mcq","3":"numeric","4":"mcq","5":"mcq","6":"written","7":"written"}:id=="nano~N9"?{"1":"mcq","2":"numeric","3":"mcq","4":"mcq","5":"mcq","6":"written","7":"written"}:id=="nano~N10"?{"1":"mcq","2":"numeric","3":"mcq","4":"mcq","5":"mcq","6":"written","7":"written"}:id=="nano~N11"?{"1":"mcq","2":"mcq","3":"mcq","4":"mcq","5":"written","6":"written"}:id=="nano~N12"?{"1":"mcq","2":"ranking","3":"mcq","4":"mcq","5":"written","6":"written"}:id=="nuclear~E1"?{"1":"mcq","2":"mcq","3":"mcq","4":"mcq","5":"mcq","6":"numeric"}:id=="nuclear~E2"?{"1":"mcq","2":"mcq","3":"mcq","4":"ranking","5":"numeric","6":"mcq"}:id=="nuclear~E3"?{"1":"mcq","2":"mcq","3":"numeric","4":"mcq","5":"mcq","6":"mcq","7":"mcq","8":"written"}:id=="nuclear~E4"?{"1":"mcq","2":"mcq","3":"mcq","4":"numeric","5":"mcq","6":"mcq","7":"numeric"}:id=="nuclear~E5"?{"1":"mcq","2":"mcq","3":"mcq","4":"mcq","5":"mcq","6":"numeric","7":"mcq","8":"numeric"}:id=="nuclear~E6"?{"1":"mcq","2":"mcq","3":"mcq","4":"mcq","5":"mcq","6":"numeric","7":"mcq","8":"mcq"}:id=="nuclear~E7"?{"1":"mcq","2":"mcq","3":"numeric","4":"mcq","5":"mcq","6":"mcq","7":"mcq","8":"numeric"}:id=="nuclear~E8"?{"1":"mcq","2":"mcq","3":"mcq","4":"mcq","5":"mcq","6":"numeric","7":"mcq","8":"mcq"}:id=="nuclear~E9"?{"1":"mcq","2":"mcq","3":"mcq","4":"numeric","5":"mcq","6":"mcq","7":"mcq","8":"numeric"}:id=="nuclear~E10"?{"1":"mcq","2":"mcq","3":"mcq","4":"mcq","5":"mcq","6":"written","7":"written","8":"mcq"}:id=="solid-state~SS1"?{"1":"mcq","2":"mcq","3":"mcq","4":"mcq","5":"ranking","6":"written","7":"written"}:id=="solid-state~SS2"?{"1":"mcq","2":"mcq","3":"numeric","4":"numeric","5":"mcq","6":"ranking","7":"written","8":"written"}:id=="solid-state~SS3"?{"1":"mcq","2":"mcq","3":"mcq","4":"numeric","5":"numeric","6":"written","7":"written"}:id=="solid-state~SS4"?{"1":"mcq","2":"mcq","3":"mcq","4":"mcq","5":"ranking","6":"written","7":"written"}:id=="solid-state~SS5"?{"1":"mcq","2":"mcq","3":"mcq","4":"mcq","5":"mcq","6":"ranking","7":"written"}:id=="solid-state~SS6"?{"1":"numeric","2":"numeric","3":"numeric","4":"mcq","5":"mcq","6":"mcq","7":"written","8":"written"}:id=="solid-state~SS7"?{"1":"mcq","2":"mcq","3":"mcq","4":"mcq","5":"ranking","6":"written","7":"written"}:id=="solid-state~SS8"?{"1":"mcq","2":"mcq","3":"numeric","4":"numeric","5":"numeric","6":"mcq","7":"written","8":"written"}:id=="84102~quiz19-session-1"?{"@practice":true}:id=="84102~quiz19-session-2"?{"@practice":true}:id=="84102~quiz19-session-3"?{"@practice":true}:id=="84102~quiz19-session-4"?{"@practice":true}:id=="84102~quiz19-session-5"?{"@practice":true}:id=="84102~quiz19-session-6"?{"@practice":true}:id=="84102~quiz19-session-7"?{"@practice":true}:id=="84102~quiz19-session-8"?{"@practice":true}:{}; }
    function time(v) { return v.at is string && v.at.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$'); }
    function topicData(d,q) {
      let key=d.changedQuestion; let old=resource==null?{}:resource.data.answers; let v=d.answers[key];
      return d.keys().hasOnly(['schema','course','topic','kind','answers','changedQuestion','updatedAt'])
        && d.kind=='topic' && key in q && d.answers is map && d.answers.keys().hasOnly(q.keys())
        && d.answers.diff(old).affectedKeys().hasOnly([key])
        && v.keys().hasOnly(['correct','kind','at']) && v.correct is bool && v.kind==q[key] && time(v);
    }
    function choice(v) { return v is int && v>=0 && v<=3; }
    function practiceData(d) { let v=d.value;
      return d.keys().hasOnly(['schema','course','topic','kind','value','updatedAt']) && d.kind=='practice'
        && v.keys().hasOnly(['choices','score','at','attempts']) && v.choices is list && v.choices.size()==10
        && choice(v.choices[0]) && choice(v.choices[1]) && choice(v.choices[2]) && choice(v.choices[3]) && choice(v.choices[4])
        && choice(v.choices[5]) && choice(v.choices[6]) && choice(v.choices[7]) && choice(v.choices[8]) && choice(v.choices[9])
        && v.score is int && v.score>=0 && v.score<=10 && v.attempts is int && v.attempts>0 && time(v);
    }
    function validProgress(id,d) { let q=questions(id);
      return q.size()>0 && d.schema==1 && id==d.course+'~'+d.topic && d.updatedAt==request.time
        && (('@practice' in q)?practiceData(d):topicData(d,q));
    }
    match /users/{uid}/studyProgress/{id} {
      allow get,list,delete: if owned(uid);
      allow create,update: if owned(uid) && validProgress(id,request.resource.data);
    }
    // Mock-exam attempts: one bounded document per attempt, owner only.
    // The paper itself is a bounded JSON string: Firestore's expression
    // budget cannot afford per-part validation of five nested questions.
    function mockStr(v,n) { return v is string && v.size()<=n; }
    function validMock(id,d) {
      return id==d.id && d.schema==1 && mockStr(d.id,64) && d.course=='84101' && mockStr(d.seed,64)
        && d.keys().hasOnly(['schema','id','course','seed','status','createdAt','submittedAt','expireAt','elapsedSec','timerRunning','drafts','selfMarks','questions','_ts'])
        && (d.status=='open'||d.status=='submitted')
        && mockStr(d.createdAt,40) && (d.submittedAt==null || mockStr(d.submittedAt,40))
        && (d.expireAt==null || mockStr(d.expireAt,40))
        && d.elapsedSec is int && d.elapsedSec>=0 && d.elapsedSec<=864000 && d.timerRunning is bool
        && d.drafts is map && d.drafts.keys().size()<=10 && d.selfMarks is map && d.selfMarks.keys().size()<=10
        && d.questions is string && d.questions.size()<=60000
        && d._ts==request.time;
    }
    match /users/{uid}/mockExam/{id} {
      allow get,list,delete: if owned(uid);
      allow create,update: if owned(uid) && validMock(id,request.resource.data);
    }
    // Privacy/account closure only, never used for ordinary progress reset.
    match /users/{uid}/studyAccess/{id} { allow read,write: if false; }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
