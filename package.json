{
  "name": "spectra-chemistry",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && npm run build:test && DIST_DIR=dist-test npm run test:browser && DIST_DIR=dist-test npm run test:pwa && DIST_DIR=dist-test npm run test:practice && DIST_DIR=dist-test npm run test:mock-exam && DIST_DIR=dist-test npm run test:papers && DIST_DIR=dist-test npm run test:final-prep && npm run test:figures",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.js",
    "test:browser": "node scripts/test-browser.mjs && node scripts/test-read-aloud.mjs && node scripts/test-progress.mjs && node scripts/test-theory-read-aloud.mjs",
    "test:practice": "node scripts/test-practice.mjs",
    "test:pwa": "node scripts/test-pwa.mjs",
    "test:papers": "node scripts/test-papers.mjs",
    "build:test": "BROWSER_TEST_STUB=1 vite build --outDir dist-test",
    "test:final-prep": "node scripts/test-final-prep.mjs",
    "rules:generate": "node scripts/build-progress-rules.mjs",
    "setup:rules": "node scripts/setup-progress-emulator.mjs",
    "test:rules": "node scripts/build-progress-rules.mjs --check && node scripts/test-progress-rules.mjs",
    "test:progress": "node scripts/test-progress.mjs",
    "test:mock-exam": "node scripts/test-mock-exam.mjs",
    "test:figures": "node scripts/test-figures.mjs"
  },
  "dependencies": {
    "firebase": "^13.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.0"
  },
  "overrides": {
    "@grpc/grpc-js": "1.13.6"
  },
  "engines": {
    "node": ">=24.12.0"
  },
  "imports": {
    "#catalogue": {
      "node": "./scripts/content-store.mjs",
      "default": "./src/catalogue.js"
    }
  }
}
